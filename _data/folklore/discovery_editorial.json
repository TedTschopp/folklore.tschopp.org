  "glossary": [
    {
      "term": "Alp",
      "description": "A high seasonal pasture and its working landscape, including huts, livestock and dairy work. It does not simply mean a mountain peak.",
      "note_label": "Alp"
    },
    {
      "term": "Senn",
      "description": "An Alpine dairyman responsible for the herd, milk processing and cheesemaking. Other workers and occupations appear beside the Senn in these tales.",
      "note_label": "Senn"
    },
    {
      "term": "Föhn",
      "description": "A warm downslope wind in the Alps, sometimes described in the stories as violent or dangerous.",
      "note_label": "Föhn"
    },
    {
      "term": "Bergmännchen",
      "description": "Literally a little mountain man: a supernatural mountain dweller. Its appearance and role depend on the particular telling.",
      "note_label": "Bergmännchen"
    },
    {
      "term": "Toggeli",
      "description": "A regional name often associated with a nightmare or pressure spirit. Local accounts do not always describe the same form.",
      "note_label": "Toggeli"
    },
    {
      "term": "Bann",
      "description": "A binding, prohibition or spell. In some tales it holds a person in place; its meaning should be read in context.",
      "note_label": "Bann"
    },
    {
      "term": "Chamois",
      "description": "A horned mountain mammal adapted to steep, rocky terrain in the European Alps.",
      "note_label": "chamois"
    },
    {
      "term": "Canton",
      "description": "One of Switzerland’s constituent states. Place names such as Aargau may name a whole canton, rather than a single village.",
      "note_label": "Aargau"
    }
  ]
