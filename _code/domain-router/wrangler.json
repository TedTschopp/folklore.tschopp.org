    "traces": {
      "enabled": false,
      "persist": false,
      "head_sampling_rate": 0
    }
  },
  "routes": [
    {
      "pattern": "folklore.tschopp.org",
      "custom_domain": true
    },
    {
      "pattern": "https://tedt.org/folklore/*",
      "zone_name": "tedt.org"
    },
    {
      "pattern": "https://tedt.org/folklore",
      "zone_name": "tedt.org"
    }
  ]
}
